{{!-- Adversaries: Project FU's list (its search and filters still work on these entries) plus what the party has learned about the one picked --}}
<section class="tab fbs-tab fbp-adv {{tab.cssClass}}" data-tab="adversaries" data-group="primary">
	<div class="adversaries content">
		<aside class="fbp-adv-side">
			<label class="search"><input type="text" name="adversarySearch" id="adversarySearch" value="{{adversarySearch}}" placeholder="Search adversaries..." aria-label="Search adversaries"></label>
			<div class="fbp-adv-filters">
				{{#each adversaryMiscFilters as |filter|}}<label class="fu-filter-option"><input type="checkbox" data-category="misc" data-option="{{filter.value}}" {{checked filter.checked}}>{{localize filter.label}}</label>{{/each}}
				{{#each adversaryRanks as |rank|}}<label class="fu-filter-option"><input type="checkbox" data-category="rank" data-option="{{rank.value}}" {{checked rank.checked}}>{{localize rank.label}}</label>{{/each}}
				{{#each adversarySpecies as |species|}}<label class="fu-filter-option"><input type="checkbox" data-category="species" data-option="{{species.value}}" {{checked species.checked}}>{{localize species.label}}</label>{{/each}}
			</div>
			<div class="entry-list">
				{{#unless adversaries.length}}<p class="fbs-empty">No adversaries yet. Study an enemy, or drag an NPC onto this sheet.</p>{{/unless}}
				{{#each fba.list}}
					<button type="button" class="section-container entry character-option {{#if sel}}sel{{/if}}" data-uuid="{{uuid}}" data-type="npc" data-action="fbuiAdversary">
						<img src="{{img}}" alt="">
						<span class="d">
							<b>{{name}}</b>
							<small>{{#if known}}{{species}} {{rank}}{{else}}Unknown{{/if}}</small>
							<span class="st t{{tier}}"><i style="width:{{pct}}%"></i></span>
						</span>
						<em class="t{{tier}}">{{tierWord}}</em>
					</button>
				{{/each}}
			</div>
		</aside>

		<div class="fbp-adv-main">
			{{#if fba.gm}}
				<div class="fbp-asplayer"><button type="button" class="{{#if fba.asPlayer}}on{{/if}}" data-action="fbuiAsPlayer" aria-pressed="{{#if fba.asPlayer}}true{{else}}false{{/if}}" data-tooltip="Show this tab exactly as the players see it"><i class="fa-solid {{#if fba.asPlayer}}fa-eye-slash{{else}}fa-eye{{/if}}"></i> {{#if fba.asPlayer}}Player view (on){{else}}View as players{{/if}}</button></div>
			{{/if}}
			{{#with fba.detail}}
				{{> "modules/fu-battle-ui/templates/party/profile.hbs"}}
			{{else}}
				<p class="fbs-empty">Pick an adversary to see what the party knows about it.</p>
			{{/with}}
		</div>
	</div>
</section>
